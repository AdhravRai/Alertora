# =========================
data/raw/*
data/processed/*
data/samples/*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/samples/.gitkeep

# Large meteorological files
*.nc
*.nc4
*.h5
*.hdf
*.grib
*.grib2
*.zip
*.tar
*.gz
*.tif
*.tiff

